[Unit]
Description=Prepare the Sound BlasterX G6 after cold boot
Documentation=https://github.com/RizeCrime/linuxblaster_control/blob/master/packaging/coldboot/README.md
After=sysinit.target
# One run per boot; a later replug must not reset the device again.
ConditionPathExists=!/run/g6-coldboot-done
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/g6-coldboot-prep.sh
TimeoutStartSec=60
